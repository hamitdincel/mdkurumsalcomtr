# ############################################################################
# ÖNEMLİ — NEXT_PUBLIC_* değişkenleri BUILD sırasında bundle'a gömülür.
# Docker kullanıyorsanız bunları runtime'da vermek yetmez; docker-compose.yml
# içindeki `build.args` bloğu bu dosyadan okur. Değeri değiştirdiğinizde
# imajı yeniden build etmeniz gerekir (`docker compose build --no-cache app`).
#
# Docker ile deploy: POSTGRES_PASSWORD değerini de bu dosyada tanımlayın.
# ############################################################################

# ----------------------------------------------------------------------------
# UYGULAMA
# ----------------------------------------------------------------------------
# Canonical host (tek host! www veya non-www seçilmeli, diğeri 301 ile yönlenir)
NEXT_PUBLIC_SITE_URL="https://www.ornekdrone.com"
NODE_ENV="development"

# ----------------------------------------------------------------------------
# VERİTABANI (PostgreSQL)
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://drone:drone@localhost:5433/drone?schema=public"

# docker-compose ile ayağa kaldırıyorsanız Postgres container'ının kimlik
# bilgileri. Production'da parolayı MUTLAKA değiştirin:
#   openssl rand -base64 32
POSTGRES_USER="drone"
POSTGRES_PASSWORD="drone"
POSTGRES_DB="drone"
# Postgres yalnızca 127.0.0.1'e bağlanır; bu yalnızca host tarafındaki porttur.
DB_PORT="5433"

# ----------------------------------------------------------------------------
# AUTH — admin oturumu (JWT, httpOnly cookie)
# openssl rand -base64 48  ile üretin
# ----------------------------------------------------------------------------
AUTH_SECRET="degistirin-en-az-32-karakter-rastgele-bir-deger-olmali"
AUTH_SESSION_MAX_AGE="28800" # saniye (8 saat)

# İlk admin kullanıcısı (yalnızca seed script tarafından kullanılır)
SEED_ADMIN_EMAIL="admin@ornekdrone.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Site Yöneticisi"

# ----------------------------------------------------------------------------
# E-POSTA
# MAIL_DRIVER: resend | smtp | console
# ----------------------------------------------------------------------------
MAIL_DRIVER="console"
MAIL_FROM="Drone Temizlik <bilgi@ornekdrone.com>"
MAIL_TO_ADMIN="teklif@ornekdrone.com"

RESEND_API_KEY=""

SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# ----------------------------------------------------------------------------
# SPAM / GÜVENLİK — Cloudflare Turnstile
# Boş bırakılırsa doğrulama devre dışı kalır (yalnızca geliştirme için).
# ----------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ----------------------------------------------------------------------------
# DOSYA DEPOLAMA (S3 uyumlu: Cloudflare R2 / AWS S3 / MinIO)
# STORAGE_DRIVER: s3 | local
# ----------------------------------------------------------------------------
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# next/image için izin verilen uzak görsel host'ları (virgülle ayrılmış)
NEXT_PUBLIC_MEDIA_HOSTNAMES=""

# ----------------------------------------------------------------------------
# ANALYTICS (boş bırakılırsa script hiç yüklenmez)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# Google Search Console doğrulama
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
